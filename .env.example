# ─────────────────────────────────────────────────────────────────────────────
# Supabase cloud project settings
# Project Settings → API and Project Settings → Database in the Supabase dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. NEVER expose to the browser. Used by the seed script and
# by trusted server actions that must bypass RLS (e.g. reading auth.users).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection — used by migrations (db:push) and Vitest integration
# tests. Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session" pooler or direct connection; the tests run DDL/DML.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# Seed accounts created by `npm run db:seed`. Change these before first run.
SEED_ADMIN_EMAIL=admin@warehouse.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MANAGER_EMAIL=manager@warehouse.local
SEED_MANAGER_PASSWORD=change-me-manager
