# Gateway configuration — copy to gateway/.env and fill in.

# Supabase (same project as the web app). Service role key — keep secret.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the terminals push to (set the same port in each device's ADMS settings).
GATEWAY_PORT=8080

# The device clock's timezone offset (India = +05:30). Device time is naive; the
# gateway attaches this to make it a real instant. Keep the device set to this tz.
DEVICE_TZ_OFFSET=+05:30

# Warehouse calendar-day timezone (must match the app's warehouse_timezone setting).
WAREHOUSE_TZ=Asia/Kolkata

# Accept these serials only (comma-separated). Leave blank to learn from the
# devices table + auto-register on first contact.
ALLOWED_SERIALS=

# Auto-add an unknown terminal to the devices table on first contact. Handy for
# setup; set to false once your devices are registered.
AUTO_REGISTER_DEVICES=true

# How often (ms) buffered punches are flushed to Supabase.
DRAIN_INTERVAL_MS=5000
